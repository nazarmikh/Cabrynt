POSTGRES_DB=CabryntPostgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
MONGO_PORT=27017
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change-me

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=CabryntPostgres;Username=postgres;Password=change-me

ConnectionStrings__Mongo=mongodb://localhost:27017
Mongo__DatabaseName=CabryntMongo


JwtToken=change-me-to-a-long-random-secret
Jwt__Issuer=Cabrynt
Jwt__Audience=CabryntClient
Jwt__ExpiryMinutes=60


Admin__Email=admin@cabrynt.test
Admin__Password=change-me


Email__FromAddress=no-reply@cabrynt.test
Email__PickupDirectory=GeneratedEmails
Email__SmtpHost=
Email__SmtpPort=
Email__SmtpUsername=
Email__SmtpPassword=
Email__UseSsl=

# Leave empty to use Cabrynt's straight-line route fallback.
# Set this to a reachable local or deployed OSRM instance to enable road routing.
Routing__OsrmBaseUrl=
Routing__UserAgent=Cabrynt/1.0 (+https://github.com/nazarmikh/Cabrynt)
Routing__RequestTimeoutSeconds=3

# The ONNX model is optional until quote-time feature integration is complete.
TripDurationModel__Enabled=false
TripDurationModel__ModelPath=

# Optional Open-Meteo quote-time weather for the trip-duration model.
Weather__Enabled=false
Weather__BaseUrl=https://api.open-meteo.com/
Weather__RequestTimeoutSeconds=3
Weather__CacheDurationMinutes=10
