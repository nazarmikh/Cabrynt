{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataProtection": {
    "ApplicationName": "Cabrynt",
    "KeyDirectory": "App_Data/data-protection-keys",
    "BlobUri": "",
    "KeyVaultKeyIdentifier": ""
  },
  "ReverseProxy": {
    "UseForwardedHeaders": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "ExitAfterMigrations": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Routing": {
    "OsrmBaseUrl": "",
    "UserAgent": "Cabrynt/1.0 (+https://github.com/nazarmikh/Cabrynt)",
    "RequestTimeoutSeconds": 3
  },
  "TripDurationModel": {
    "Enabled": false,
    "ModelPath": "",
    "ModelArtifactUrl": "",
    "MetadataUrl": "",
    "ExpectedVersion": "1.0.0",
    "CacheDirectory": "App_Data/models",
    "DownloadTimeoutSeconds": 15
  },
  "Weather": {
    "Enabled": false,
    "BaseUrl": "https://api.open-meteo.com/",
    "RequestTimeoutSeconds": 3,
    "CacheDurationMinutes": 10
  },
  "AllowedHosts": "*"
}
