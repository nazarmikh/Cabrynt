@host = http://localhost:5113

###
# Health/root
GET {{host}}/
Accept: application/json

###
# Register passenger
POST {{host}}/api/public/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "local-passenger@example.com",
  "password": "StrongPass123!",
  "name": "Local Test Passenger",
  "homeAddress": "Main Street 1, Bruges",
  "preferredPaymentMethod": "Card"
}

###
# Admin login
# The REST client stores the Cabrynt.Auth cookie from this response.
POST {{host}}/api/public/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@cabrynt.test",
  "password": "AdminPassword123!"
}

###
# Test /me after login. The stored Cabrynt.Auth cookie is sent automatically.
GET {{host}}/api/public/auth/me
Accept: application/json

###
# Logout. Clears the stored Cabrynt.Auth cookie.
POST {{host}}/api/public/auth/logout
Accept: application/json
