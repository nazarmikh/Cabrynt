@host = http://localhost:5113
@accessToken =

###
# Health/root
GET {{host}}/
Accept: application/json

###
# Register passenger
POST {{host}}/api/public/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "local-passenger@example.com",
  "password": "StrongPass123!",
  "name": "Local Test Passenger",
  "homeAddress": "Main Street 1, Bruges",
  "preferredPaymentMethod": "Card"
}

###
# Admin login
POST {{host}}/api/public/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@novadrive.com",
  "password": "AdminPassword123!"
}

###
# Test /me after pasting a token into @accessToken
GET {{host}}/api/public/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json
