@host = http://localhost:5113
@adminEmail = admin@cabrynt.test
@adminPassword = AdminPassword123!

# Optional legacy check for the standalone payment endpoint.
# In the current app flow, ride completion already creates payment automatically.
# Run Admin login first. The REST client stores the Cabrynt.Auth cookie
# and sends it automatically to the protected payment endpoint below.

@rideId =

###
# 1. Admin login
POST {{host}}/api/public/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# 2. Manual payment creation for an already completed ride
POST {{host}}/api/private/rides/{{rideId}}/payments
Content-Type: application/json
Accept: application/json

{
  "rideId": {{rideId}}
}
