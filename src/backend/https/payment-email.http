###
# 1. Admin login
POST {{host}}/api/public/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# 2. Manual payment creation for an already completed ride
POST {{host}}/api/private/rides/{{rideId}}/payments
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "rideId": {{rideId}}
}

