using '../main.bicep'

param location = 'francecentral'
param applicationName = 'cabrynt'
param resourceGroupName = 'rg-cabrynt-prod-frc'
param postgresAdministratorLogin = 'cabryntadmin'
param adminEmail = 'replace-with-your-admin-email@example.com'
param frontendOrigin = 'https://replace-with-your-vercel-domain.vercel.app'
param backendImage = 'ghcr.io/nazarmikh/cabrynt-backend:replace-with-commit-sha'
param osrmImage = 'ghcr.io/nazarmikh/cabrynt-osrm:replace-with-commit-sha'
// Do not add postgresAdministratorPassword here. Pass it through Azure CLI at deployment time.
