@host = http://localhost:5113
@runId = teacher02
@adminEmail = admin@cabrynt.test
@adminPassword = AdminPassword123!

# Cookie auth note:
# The REST client stores the Cabrynt.Auth cookie from the latest login response.
# Only one user session is active at a time for this host, so run the matching
# Admin, Passenger, or Vehicle login before requests that require that role.

@rideId = 
@ticketId =
@maintenanceId =
# Optional for vehicle and maintenance requests.
@vehicleId = 

###
# 1. Admin login
POST {{host}}/api/public/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# 2. Register a demo passenger
POST {{host}}/api/public/auth/register
Content-Type: application/json
Accept: application/json

{
  "email": "teacher-passenger-{{runId}}@cabrynt.test",
  "password": "StrongPass123!",
  "name": "Teacher Demo Passenger",
  "homeAddress": "Demo Avenue 1, Ghent",
  "preferredPaymentMethod": "Card"
}

###
# 3. Passenger login
POST {{host}}/api/public/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "teacher-passenger-{{runId}}@cabrynt.test",
  "password": "StrongPass123!"
}

###
# 4. Passenger profile
GET {{host}}/api/public/auth/me
Accept: application/json

###
# 5. Optional setup only:
# Run Admin login again before this request if Passenger login was the latest login.
# Register a dedicated vehicle if you want to demonstrate the admin-only vehicle endpoint.
# Otherwise keep @vehicleId pointed at an existing seeded/simulated vehicle and skip to step 6.
POST {{host}}/api/private/vehicles
Content-Type: application/json
Accept: application/json

{
  "vin": "1HGCM82633A00{{runId}}",
  "licencePlate": "TCH-{{runId}}",
  "model": "Tesla Model Y",
  "vehicleType": "Standard",
  "year": 2024,
  "systemEmail": "teacher-vehicle-{{runId}}@cabrynt.test",
  "systemPassword": "StrongPass123!"
}

###
# 6. Optional setup only:
# Vehicle login for the newly registered vehicle.
# Copy the returned vehicleId into @vehicleId if you use the dedicated vehicle flow above.
POST {{host}}/api/public/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "teacher-vehicle-{{runId}}@cabrynt.test",
  "password": "StrongPass123!"
}

###
# 7. Create ride request
# Run Passenger login again before this request if Vehicle login was the latest login.
# Copy rideId from the response into @rideId above.
POST {{host}}/api/public/rides
Content-Type: application/json
Accept: application/json

{
  "departureLocation": "Aliados",
  "destinationLocation": "Boavista",
  "departureLatitude": 41.149,
  "departureLongitude": -8.611,
  "destinationLatitude": 41.16,
  "destinationLongitude": -8.64,
  "preferredVehicleType": "Standard"
}

###
# 8. List ride requests
GET {{host}}/api/public/rides
Accept: application/json

###
# 9. Get ride request by id
GET {{host}}/api/public/rides/{{rideId}}
Accept: application/json

###
# 10. Cancel a ride request
# Run Passenger login again before this request.
DELETE {{host}}/api/public/rides/{{rideId}}
Accept: application/json

###
# 11. Create support ticket
# Run Passenger login again before this request.
# Copy ticketId from the response into @ticketId above.
POST {{host}}/api/public/tickets
Content-Type: application/json
Accept: application/json

{
  "subject": "Ride quality issue",
  "description": "The cabin temperature was not comfortable during the trip.",
  "ticketPriority": "Medium"
}

###
# 12. List passenger tickets
GET {{host}}/api/public/tickets
Accept: application/json

###
# 13. Get ticket by id
GET {{host}}/api/public/tickets/{{ticketId}}
Accept: application/json

###
# 14. Create maintenance record
# Run Admin login again before this request.
# Copy maintenanceId from the response into @maintenanceId above.
POST {{host}}/api/private/vehicles/{{vehicleId}}/maintenances
Content-Type: application/json
Accept: application/json

{
  "serviceDate": "2026-04-16T12:00:00Z",
  "description": "Quarterly inspection and brake calibration",
  "technicianName": "Alex Maintenance",
  "cost": 249.99,
  "nextInspectionMileage": 60000
}

###
# 15. List maintenance records for the vehicle
GET {{host}}/api/private/vehicles/{{vehicleId}}/maintenances
Accept: application/json

###
# 16. Get maintenance by id
GET {{host}}/api/private/vehicles/{{vehicleId}}/maintenances/{{maintenanceId}}
Accept: application/json
