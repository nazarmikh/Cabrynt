@host = http://localhost:5113
@adminEmail = admin@novadrive.com
@adminPassword = AdminPassword123!

# Setup helper only. Keep this file if you want to register dedicated demo vehicles quickly.

@adminToken =

###
# Admin login
POST {{host}}/api/public/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

###
# Register Standard Vehicle 1
POST {{host}}/api/private/vehicles
Authorization: Bearer {{adminToken}}
Content-Type: application/json
Accept: application/json

{
  "vin": "1HGCM82633A004351",
  "licencePlate": "ND-ST-001",
  "model": "Tesla Model 3",
  "vehicleType": "Standard",
  "year": 2023,
  "systemEmail": "vehicle.standard1@novadrive.test",
  "systemPassword": "StrongPass123!"
}

###
# Register Standard Vehicle 2
POST {{host}}/api/private/vehicles
Authorization: Bearer {{adminToken}}
Content-Type: application/json
