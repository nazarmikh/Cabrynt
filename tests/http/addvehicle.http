{
  "vin": "1HGCM82633A004352",
  "licencePlate": "ND-ST-002",
  "model": "Hyundai Ioniq 5",
  "vehicleType": "Standard",
  "year": 2024,
  "systemEmail": "vehicle.standard2@novadrive.test",
